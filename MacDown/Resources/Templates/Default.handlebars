<!DOCTYPE html>
<html>

<head>

<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=yes">
{{{ titleTag }}}

{{#each styleTags }}
{{{ this }}}
{{/each }}

<!-- Scripts belong in the head here, not at the end of the body: the
     preview refreshes by replacing the body's innerHTML, and a script
     inserted that way never runs. -->
{{#each scriptTags }}
{{{ this }}}
{{/each }}

</head>

<body>

{{{ body }}}

</body>

</html>
